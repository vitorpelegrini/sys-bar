<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- A small service that reads a few sensors once a second: the non-concurrent workstation collector
         needs no background GC thread and keeps less memory committed. -->
    <gcConcurrent enabled="false" />
    <gcServer enabled="false" />
    <!-- No Authenticode evidence for the executable at startup: once it is signed, building that evidence
         can wait on the network for a revocation list, long enough for the service start to time out. -->
    <generatePublisherEvidence enabled="false" />
  </runtime>
</configuration>
